#!/usr/bin/env bash
# SessionStart hook (Claude Code and Codex; the OpenCode plugin runs it too). Injects rules/core.md plus the flow
# section (rules/flujo.md, or rules/sin-flujo.md with "flujo": false) only when the session's repo has .agents-kit.json
# at its root and it does not set "reglas": false; otherwise silent, exit 0. An unreadable marker counts as defaults.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cwd=""
if [ ! -t 0 ]; then
  input="$(cat 2>/dev/null)"
  if [ -n "$input" ]; then
    cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)" || cwd=""
  fi
fi
[ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$PWD"

root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$root" ] && [ -f "$root/.agents-kit.json" ] || exit 0
[ -f "$PLUGIN_ROOT/rules/core.md" ] || exit 0
flags="$(jq -r '"\(.reglas != false) \(.flujo != false)"' "$root/.agents-kit.json" 2>/dev/null)" || flags="true true"
[ "${flags% *}" != false ] || exit 0
flow="$PLUGIN_ROOT/rules/flujo.md"
[ "${flags#* }" != false ] || flow="$PLUGIN_ROOT/rules/sin-flujo.md"

header="agents-kit está activo en este repo. Reglas adicionales (léelas cuando apliquen): $PLUGIN_ROOT/rules/testing.md y $PLUGIN_ROOT/rules/docs-discipline.md."

{ printf '%s\n\n' "$header"; cat "$PLUGIN_ROOT/rules/core.md"; [ ! -f "$flow" ] || { echo; cat "$flow"; }; } \
  | jq -Rs '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}'
exit 0
