#!/usr/bin/env bash
# PostToolUse hook (Edit|Write|MultiEdit|NotebookEdit, and Codex's apply_patch: the files of the patch that exist,
# one run per command with all of its files). Runs `<comando> <ruta>` from the repo root, where <comando>
# is the .lint.fichero entry whose comma-separated keys include the file's extension (without case) and <ruta> is
# relative to the root (with ./ in front, so a name starting with - is not an option). Exit 2 with the lint output on
# stderr when it fails; 0 when it passes, when another lint holds the lock, when the tool is missing (126/127) or after
# KIT_LINT_TIMEOUT (10 s, per command). Inert as described in hooks/lib-reglas.sh, and for
# paths outside the repo, files that do not exist or extensions without a command.
source "$(dirname "${BASH_SOURCE[0]:-$0}")/lib-reglas.sh" || exit 0
kr_input && [ ${#KR_ITEMS[@]} -gt 0 ] && kr_root || exit 0
cmds=(); rels=(); i=0
while [ $i -lt ${#KR_ITEMS[@]} ]; do
  KR_FILE="${KR_ITEMS[$i]}"; i=$((i + 2))
  kr_resolve && [ -f "$KR_ROOT/$KR_REL" ] || continue
  kr_ext
  [ -n "$KR_EXT" ] && kr_config "$KR_EXT" && [ -n "$KR_CMD" ] || continue
  cmds+=("$KR_CMD"); rels+=("$KR_REL")
done
[ ${#cmds[@]} -gt 0 ] || exit 0
# One run per command, with its files in the order of the input; the lock covers all of them.
t="$(kr_tope "${KIT_LINT_TIMEOUT:-}" 10)"
hechos=$'\n'; n=0
for c in "${cmds[@]}"; do case "$hechos" in *$'\n'"$c"$'\n'*) ;; *) hechos="$hechos$c"$'\n'; n=$((n + 1)) ;; esac; done
kr_lock $((t * n)) || exit 0
KR_LOCK_OK=1; final=0; hechos=$'\n'
for c in "${cmds[@]}"; do
  case "$hechos" in *$'\n'"$c"$'\n'*) continue ;; esac
  hechos="$hechos$c"$'\n'; args=(); what=""; j=0
  while [ $j -lt ${#cmds[@]} ]; do
    [ "${cmds[$j]}" != "$c" ] || { args+=("./${rels[$j]}"); what="${what:+$what, }${rels[$j]}"; }
    j=$((j + 1))
  done
  kr_lint "$t" "$what" "$c" "${args[@]}" || final=2
done
exit $final
