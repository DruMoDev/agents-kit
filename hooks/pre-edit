#!/usr/bin/env bash
# PreToolUse hook (Edit|Write|MultiEdit|NotebookEdit, and Codex's apply_patch: every file of the patch, see kr_input in
# hooks/lib-reglas.sh; a patch with no file to read blocks). Exit 2 with the remedy on stderr when the edit
#   - raises the number of eslint-disable, @ts-ignore, @ts-nocheck or `as any` (KR_PROHIBIDO) in a code file
#     (extension, without case, in the keys of .lint.fichero or KR_CODIGO): the whole file before and after the edit
#     (kr_sube_prohibido, over every field present), so inherited occurrences kept as they are do not count; an edit
#     whose old_string is not in the file, or a NotebookEdit cell, blocks with any match in its new text, and a check
#     that cannot run (jq error, unreadable file) blocks too; or
#   - touches a shielded file (.blindado) without <git-common-dir>/agents-kit/reglas-abiertas holding this session_id
#     (kit-reglas.sh abrir). package.json is not checked here: kit-pr.sh fusionar does it.
# Paths and globs are compared without case on macOS; a symlink is checked by its target, and a target outside the
# repo does nothing. Inert (exit 0, no output) as described in hooks/lib-reglas.sh, and for paths outside the repo of
# the input's cwd.
source "$(dirname "${BASH_SOURCE[0]:-$0}")/lib-reglas.sh" || exit 0
kr_input && { [ ${#KR_ITEMS[@]} -gt 0 ] || [ -n "$KR_PARCHE" ]; } && kr_root || exit 0
if [ ${#KR_ITEMS[@]} -eq 0 ]; then
  kr_config || exit 0
  echo "No se pudo leer el parche (apply_patch) para comprobar las reglas; se bloquea por si acaso." >&2
  exit 2
fi
source "$KR_PLUGIN/scripts/lib/blindado.sh"
nocase=""
case "$OSTYPE" in darwin*) nocase=1 ;; esac
i=0
while [ $i -lt ${#KR_ITEMS[@]} ]; do
  KR_FILE="${KR_ITEMS[$i]}"; KR_JSON="${KR_ITEMS[$((i + 1))]}"; i=$((i + 2))
  kr_resolve || continue
  kr_ext
  kr_config "$KR_EXT" || exit 0
  en=""
  [ -z "$KR_PARCHE" ] || en="$KR_REL: "
  if kr_codigo "$KR_EXT"; then
    case "$(kr_sube_prohibido)" in
      no) ;;
      sube) echo "${en}No desactives reglas ni tipos: arregla la causa. Si la regla está mal, propón el cambio (kit-reglas)." >&2
        exit 2 ;;
      *) echo "${en}No se pudo comprobar si la edición desactiva reglas o tipos (¿el fichero se puede leer?); se bloquea por si acaso." >&2
        exit 2 ;;
    esac
  fi
  if kit_blindado_match "$KR_REL" "$KR_GLOBS" $nocase; then
    abierta=""
    [ ! -f "$KR_COMMON/agents-kit/reglas-abiertas" ] || IFS= read -r abierta < "$KR_COMMON/agents-kit/reglas-abiertas"
    if [ -z "$KR_SID" ] || [ "$abierta" != "$KR_SID" ]; then
      echo "${en}Fichero de reglas: solo se cambia con la aprobación de Dru (skill kit-reglas, o en kit-run un commit propio y kit-pr.sh regla)." >&2
      exit 2
    fi
  fi
done
exit 0
