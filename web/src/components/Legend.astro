---
import { ENTRY_TYPES } from "../lib/changelog";
import { TYPE_META } from "../lib/ui";
---

<ul class="legend" aria-label="Tipos de cambio">
  {
    ENTRY_TYPES.map((t) => (
      <li class={`legend-item legend-${TYPE_META[t].slug}`} title={TYPE_META[t].hint}>
        {t}
      </li>
    ))
  }
  <li class="legend-item legend-unseen">Sin ver</li>
</ul>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend-item::before {
    content: "";
    width: 4px;
    height: 14px;
    border-radius: 2px;
    background: var(--c);
  }
  .legend-nuevo { --c: var(--nuevo); }
  .legend-mejora { --c: var(--mejora); }
  .legend-arreglo { --c: var(--arreglo); }
  .legend-interno { --c: var(--interno); }
  .legend-unseen::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
  }
</style>
