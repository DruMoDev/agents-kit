---
import type { Repo } from "../lib/github";
import { countLabel, formatShortDate, TYPE_META } from "../lib/ui";

interface Props {
  repo: Repo;
  seen: Set<number>;
  unseen: number;
}
const { repo, seen, unseen } = Astro.props;

const MAX_TICKS = 28;
const entries = repo.days.flatMap((d) => d.entries);
// la tira va de más antiguo (izquierda) a más reciente (derecha)
const ticks = entries.slice(0, MAX_TICKS).reverse();
const total = entries.length;
const href = `/app/${encodeURIComponent(repo.name)}`;
const state = total === 0 ? "empty" : unseen > 0 ? "unseen" : "done";
---

<li class={`card is-${state}`} data-repo={repo.name} data-unseen={unseen}>
  <div class="card-head">
    <h2 class="card-name"><a href={href}>{repo.name}</a></h2>
    {state === "unseen" && <span class="unseen-badge card-count">{unseen} sin ver</span>}
    {
      state === "done" && (
        <span class="card-done">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Al día
        </span>
      )
    }
  </div>

  {
    total > 0 ? (
      <div class="strip" aria-hidden="true">
        {ticks.map((e) => (
          <span class={`tick tick-${TYPE_META[e.type].slug}${seen.has(e.pr) ? "" : " tick-unseen"}`} />
        ))}
      </div>
    ) : (
      <div class="strip strip-empty" aria-hidden="true" />
    )
  }

  <p class="card-meta">
    {
      total > 0 && repo.lastDate ? (
        <>
          <span>Último cambio el {formatShortDate(repo.lastDate)}</span>
          <span class="card-total">{countLabel(total, "cambio", "cambios")}</span>
        </>
      ) : (
        <span>Sin cambios todavía</span>
      )
    }
  </p>
</li>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 0.875rem;
    padding: 1.125rem 1.125rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  /* con novedades: la tarjeta entera toma el tinte de la señal */
  .card.is-unseen {
    background: var(--signal-soft);
    border-color: var(--signal-line);
  }
  .card.is-unseen:hover {
    border-color: var(--signal);
  }
  .card.is-unseen .strip {
    border-bottom-color: var(--signal-line);
  }
  .card.is-empty {
    background: transparent;
    border-style: dashed;
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .card-name a {
    text-decoration: none;
  }
  .card-name a:focus-visible {
    outline: none;
  }
  /* toda la tarjeta es el enlace */
  .card-name a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card.is-empty .card-name {
    color: var(--muted);
  }
  .card-count {
    font-size: var(--step--1);
    padding: 0.25rem 0.625rem;
    margin-top: 0.125rem;
  }
  .card-done {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .strip {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 34px;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line);
  }
  .strip-empty {
    height: 12px;
  }
  .tick {
    flex: 0 0 auto;
    width: 6px;
    height: 12px;
    border-radius: 3px;
    background: var(--c);
    opacity: 0.45;
  }
  .tick-unseen {
    height: 30px;
    opacity: 1;
    box-shadow: inset 0 6px 0 var(--signal);
  }
  .tick-nuevo { --c: var(--nuevo); }
  .tick-mejora { --c: var(--mejora); }
  .tick-arreglo { --c: var(--arreglo); }
  .tick-interno { --c: var(--interno); }

  .card.is-unseen .card-meta {
    color: var(--ink);
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .card-total {
    font-variant-numeric: tabular-nums;
  }
</style>
