{
  "name": "agents-kit-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "astro sync && KIT_TSC=node_modules/typescript7/bin/tsc node .agents-kit/tsc-base.mjs comprobar"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
