#!/usr/bin/env bash
# gh stub. Logs args to $GH_LOG; behaviour chosen by $GH_STUB_MODE:
#   ok                  default branch main, no changelog issue yet
#   default-branch-trunk  default branch trunk
#   issue-exists        changelog issue already present
#   merge-open          `gh pr view` reports OPEN (merge did not happen)
#   merge-fails-merged  `gh pr merge` exits 1 but `gh pr view` reports MERGED
#   no-auth             `gh auth status` fails
#   no-remote           `gh repo view` fails
#   labels-exist        `gh label list` reports en-curso and prio:alta (others: no labels)
#   label-list-fails    `gh label list` fails
#   pr-open             `gh pr list` reports an open PR (#5)
#   pr-create-fails     `gh pr create` fails
# CI (gh api), chosen by $GH_CI: empty = no workflows; verde | rojo | esperando = one workflow whose check run ends so.
# $GH_RUNS_SLOW: seconds of the slowest recent green run (actions/runs, default 0).
[ -n "${GH_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_LOG"
mode="${GH_STUB_MODE:-ok}"
branch=main
[ "$mode" = default-branch-trunk ] && branch=trunk
if [ "$1 $2" = "auth status" ]; then [ "$mode" = no-auth ] && exit 1; exit 0; fi
case "$1 $2" in
  "repo view")
    if [ "$mode" = no-remote ]; then
      echo "no git remotes found" >&2; exit 1
    fi
    printf '{"nameWithOwner":"dru/demo","defaultBranchRef":{"name":"%s"}}\n' "$branch" ;;
  "issue list")
    if [ "$mode" = issue-exists ]; then
      echo '[{"number":7,"title":"📦 Changelog"},{"number":8,"title":"📦 Changelog extra"}]'
    else
      echo '[{"number":9,"title":"📦 Changelog extra"}]'
    fi ;;
  "label list")
    [ "$mode" = label-list-fails ] && exit 1
    if [ "$mode" = labels-exist ]; then echo '[{"name":"en-curso"},{"name":"prio:alta"},{"name":"otra"}]'; else echo '[]'; fi ;;
  "issue create") echo "https://github.com/dru/demo/issues/7" ;;
  "pr view") # MERGED only once a merge was attempted (logged), unless merge-open
    if [ "$mode" = merge-open ] || { [ -n "${GH_LOG:-}" ] && ! grep -q '^pr merge' "$GH_LOG"; }; then echo OPEN; else echo MERGED; fi ;;
  "pr merge") [ "$mode" = merge-fails-merged ] && exit 1
    case " $* " in *" --delete-branch "*) git push -q origin --delete "$(git rev-parse --abbrev-ref HEAD)" >/dev/null 2>&1 ;; esac ;;
  "pr create") [ "$mode" = pr-create-fails ] && exit 1; echo "https://github.com/dru/demo/pull/1" ;;
  "api repos/dru/demo/actions/workflows") if [ -n "${GH_CI:-}" ]; then echo 1; else echo 0; fi ;;
  "api repos/dru/demo/commits/"*)
    case "${GH_CI:-}" in
      verde) st=completed c='"success"' ;; rojo) st=completed c='"failure"' ;; *) st=in_progress c=null ;;
    esac
    printf '{"check_runs":[{"id":1,"name":"suite","app":{"id":1},"status":"%s","conclusion":%s}]}\n' "$st" "$c" ;;
  "api repos/dru/demo/actions/runs"*) echo "${GH_RUNS_SLOW:-0}" ;; # already the --jq answer: slowest green run (s)
  "pr list") if [ "$mode" = pr-open ]; then echo '[{"number":5,"url":"https://github.com/dru/demo/pull/5","headRefOid":"abc123","isCrossRepository":false},{"number":6,"url":"https://github.com/dru/demo/pull/6","headRefOid":"f0f0f0","isCrossRepository":true}]'; else echo '[]'; fi ;;
esac
exit 0
