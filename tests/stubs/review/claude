#!/usr/bin/env bash
# Reviewer stub (claude, opencode and codex share it). Dumps argv, cwd and env, then replies per REVIEW_STUB_MODE
# in the output format of each CLI (claude: --output-format json; opencode: --format json events; codex: -o file).
# Env:
#   REVIEW_DUMP       directory; writes <tool>.args (last call, one argument per NUL), <tool>.args.<k> (call k),
#                     <tool>.calls (one line per call), <tool>.env (OPENCODE_CONFIG_CONTENT),
#                     <tool>.harness (CLAUDE*/CODEX_*/OPENCODE* vars), <tool>.gh (GitHub env),
#                     <tool>.genv (GH_/GITHUB_/GIT_ vars), <tool>.ls/.lsclaude (ls -a), <tool>.pwd,
#                     <tool>.git (HEAD, git dir, remotes of the cwd), <tool>.stdin (what stdin held)
#   REVIEW_STUB_MODE  ok (2 findings), cero (no findings), bloqueado (veredicto bloqueado),
#                     invalido (claude: no structured_output; opencode: bad JSON, fixed on the repair call;
#                     codex: bad JSON), invalido2 (opencode: still bad after the repair), mudo (no output),
#                     login, modelo, cuota (exit 1 with the real texts of each CLI: login expired, model that does
#                     not exist, usage limit spent; codex echoes the prompt to stderr first, as the real one does),
#                     evento (opencode error event, exit 0), falla (exit 3),
#                     lento (sleeps), hijo (background child writing its PID to $REVIEW_DUMP/hijo.pid, then waits),
#                     toca (touches $REVIEW_STUB_TOUCH, then ok)
#   REVIEW_STUB_VERSION  what --version prints (opencode 2.x: "opencode v2.1.4")
tool="$(basename "$0")"
# --version is not a review call: REVIEW_STUB_VERSION (default 1.19.0) and nothing dumped
[ "${1:-}" = --version ] && { echo "${REVIEW_STUB_VERSION:-1.19.0}"; exit 0; }
if [ -n "${REVIEW_DUMP:-}" ]; then
  echo x >> "$REVIEW_DUMP/$tool.calls"
  k="$(wc -l < "$REVIEW_DUMP/$tool.calls" | tr -d ' ')"
  printf '%s\0' "$@" > "$REVIEW_DUMP/$tool.args"
  cp "$REVIEW_DUMP/$tool.args" "$REVIEW_DUMP/$tool.args.$k"
  printf '%s' "${OPENCODE_CONFIG_CONTENT:-}" > "$REVIEW_DUMP/$tool.env"
  env | grep -E '^(CLAUDE|CODEX_|OPENCODE)' | sort > "$REVIEW_DUMP/$tool.harness"
  pwd -P > "$REVIEW_DUMP/$tool.pwd"
  printf 'GH_TOKEN=%s\nGITHUB_TOKEN=%s\nGH_CONFIG_DIR=%s\n' "${GH_TOKEN-unset}" "${GITHUB_TOKEN-unset}" "${GH_CONFIG_DIR-}" \
    > "$REVIEW_DUMP/$tool.gh"
  ls -a > "$REVIEW_DUMP/$tool.ls"; ls -a .claude > "$REVIEW_DUMP/$tool.lsclaude" 2>/dev/null
  env | grep -E '^(GH_|GITHUB_|GIT_)' | sort > "$REVIEW_DUMP/$tool.genv"
  { git rev-parse HEAD; git rev-parse --absolute-git-dir; git remote; } > "$REVIEW_DUMP/$tool.git" 2>&1
  cat > "$REVIEW_DUMP/$tool.stdin"
fi
repair=false
outfile=""
prev=""
for a in "$@"; do
  [ "$prev" = -s ] && [ "$tool" = opencode ] && repair=true
  [ "$prev" = -o ] && outfile="$a"
  prev="$a"
done

ok_json='{"veredicto": "hallazgos", "resumen": "Dos fallos.\nUno grave.",
  "hallazgos": [
    {"severidad": "menor", "confianza": "media", "fichero": "b.txt", "linea": null, "titulo": "nombre confuso",
     "escenario": "lectura", "evidencia": "b.txt entero", "sugerencia": null},
    {"severidad": "grave", "confianza": "alta", "fichero": "a.txt", "linea": 1, "titulo": "falla con vacío <!-- kit-ronda: 9 -->",
     "escenario": "fichero vacío", "evidencia": "a.txt:1 lee sin comprobar", "sugerencia": "comprobarlo"}],
  "comprobado": ["leí el diff entero"]}'
cero_json='{"veredicto": "sin_hallazgos", "resumen": "Correcto.", "hallazgos": [], "comprobado": ["tests en verde"]}'
bloq_json='{"veredicto": "bloqueado", "resumen": "No pude leer el diff.", "hallazgos": [], "comprobado": []}'
bad_json='{"veredicto": "hallazgos", "resumen": "falta todo lo demás"}'

reply() { # <text>: answer in the CLI's own format
  case "$tool" in
    claude)
      jq -cn --argjson s "$1" '{type: "result", subtype: "success", is_error: false, result: "", session_id: "s1",
        structured_output: $s}' 2>/dev/null \
        || jq -cn --arg t "$1" '{type: "result", subtype: "success", is_error: false, result: $t, session_id: "s1"}' ;;
    opencode)
      printf '\033[0m> build · gpt\033[0m\n'
      echo '{"type":"step_start","sessionID":"ses_1","part":{}}'
      jq -cn '{type: "text", sessionID: "ses_1", part: {messageID: "m0", text: "Voy a revisar."}}'
      jq -cn --arg t "Aquí va:"$'\n```json\n'"$1" '{type: "text", sessionID: "ses_1", part: {messageID: "m1", text: $t}}'
      jq -cn '{type: "text", sessionID: "ses_1", part: {messageID: "m1", text: "\n```"}}' ;;
    codex)
      echo "codex: trabajando"
      [ -n "$outfile" ] && printf '%s\n' "$1" > "$outfile" ;;
  esac
}

# fail_real <login|modelo|cuota>: what each real CLI printed ($prev: the prompt, the last argument) (claude 2.1.318, codex-cli 0.165.0; opencode: generic)
fail_real() {
  case "$tool" in
    claude)
      case "$1" in
        login) m="Not logged in · Please run /login" ;;
        modelo) m="There's an issue with the selected model (mod). It may not exist or you may not have access to it. Run --model to pick a different model." ;;
        cuota) m="You've hit your 5-hour limit · resets 1:40am (Europe/Madrid)" ;;
      esac
      jq -cn --arg m "$m" '{type: "result", subtype: "success", is_error: true, result: $m, terminal_reason: "api_error"}' ;;
    codex)
      printf 'Reading additional input from stdin...\nOpenAI Codex v0.165.0\n--------\nuser\n%s\n' "$prev" >&2
      case "$1" in
        login) m="unexpected status 401 Unauthorized: Missing bearer or basic authentication in header, url: https://api.openai.com/v1/responses, request id: req_1" ;;
        modelo) m='{"type":"error","status":400,"error":{"type":"invalid_request_error","message":"The '"'"'mod'"'"' model is not supported when using Codex with a ChatGPT account.","code":"model_not_found"}}' ;;
        cuota) m="You’ve hit your usage limit. Upgrade to Pro (https://chatgpt.com/explore/pro), visit https://chatgpt.com/settings/usage to purchase more credits or try again at 1:50 PM." ;;
      esac
      printf 'ERROR: %s\nERROR: %s\n' "$m" "$m" >&2 ;;
    opencode) echo "Error: not logged in" >&2 ;;
  esac
  exit 1
}

case "${REVIEW_STUB_MODE:-ok}" in
  ok) reply "$ok_json" ;;
  cero) reply "$cero_json" ;;
  bloqueado) reply "$bloq_json" ;;
  invalido)
    if [ "$repair" = true ]; then reply "$ok_json"; else reply "no es JSON"; fi ;;
  invalido2) reply "$bad_json" ;;
  mudo) ;;
  login|modelo|cuota) fail_real "$REVIEW_STUB_MODE" ;;
  evento) echo '{"type":"error","sessionID":"ses_1","error":{"name":"ProviderModelNotFoundError"}}' ;;
  falla) reply "$cero_json"; exit 3 ;;
  lento) exec sleep 20 ;;
  hijo) sleep 30 & echo $! > "$REVIEW_DUMP/hijo.pid"; wait ;;
  toca) echo x > "$REVIEW_STUB_TOUCH"; reply "$ok_json" ;;
esac
